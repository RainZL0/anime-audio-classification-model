# Line endings are LF in the repo. On checkout, core.autocrlf decides the form in the working tree.
* text=auto eol=lf

# Binary files
*.wav binary
*.flac binary
*.mp3 binary
*.mkv binary
*.mp4 binary
*.ckpt binary
*.pth binary
*.onnx binary
*.parquet binary

# Lock file: do not expand it in diffs
uv.lock -diff linguist-generated
